# Sınıf İçi Bilgi Yarışması — Ortam Değişkenleri
# Bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun.
# .env.local dosyası .gitignore içinde olmalı, GitHub'a asla push edilmemeli.

# AI API Key — Fen Bilimleri AI Öğretmeni (Gemini API) için
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.6-flash"

# Veritabanı bağlantıları (Prisma / Supabase / Postgres)
DATABASE_URL="postgres://user:password@host:5432/dbname"
POSTGRES_URL="postgres://user:password@host:5432/dbname"
PRISMA_DATABASE_URL="postgres://user:password@host:5432/dbname"
